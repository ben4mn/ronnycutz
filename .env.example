NODE_ENV=production
PORT=3001

# Gmail for sending booking confirmations
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Email that gets booking notifications
NOTIFY_EMAIL=aaron@example.com

# Long random strings — generate with: openssl rand -hex 32
CALENDAR_FEED_TOKEN=REPLACE_WITH_RANDOM_SECRET
ADMIN_TOKEN=REPLACE_WITH_RANDOM_SECRET

# Public base URL (used in booking confirmation links and ICS UIDs)
PUBLIC_BASE_URL=https://ronnycutz.4mn.org
